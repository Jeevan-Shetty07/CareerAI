PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerai

# Security & JWT
JWT_SECRET=super-secure-careerai-secret-key-2026-xyz
JWT_REFRESH_SECRET=super-secure-careerai-refresh-secret-key-2026-abc
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# AI Configuration (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_api_key_here

# Redis (optional, fallback in-memory cache provided)
REDIS_URL=redis://localhost:6379

# GitHub Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
